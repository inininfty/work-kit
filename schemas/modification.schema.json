{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "modification.schema.json",
  "title": "修改账本单行（只追加）",
  "type": "object",
  "required": ["id", "for_task", "files_created", "files_modified"],
  "properties": {
    "id": { "type": "string", "pattern": "^M-[0-9]{3,}$" },
    "for_task": { "type": "string", "pattern": "^T-[0-9]{3,}$" },
    "via_change_list": { "type": "string", "pattern": "^C-[0-9]{3,}$" },
    "files_created": { "type": "array", "items": { "type": "string" } },
    "files_modified": { "type": "array", "items": { "type": "string" } },
    "files_deleted": { "type": "array", "items": { "type": "string" } },
    "outside_change_list": { "type": "array", "items": { "type": "string" } },
    "gate_result": { "type": "object" },
    "note": { "type": "string" }
  }
}
